# Получить на https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# Ваше имя — то же, что использовалось при подготовке датасета
MY_NAME=Андрей
# Необязательно: файл с фактами о вас (учёба, работа, город, интересы)
# PERSONA_FILE=persona.txt

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=twin
TEMPERATURE=0.7

# Через сколько секунд после последнего сообщения собеседника отвечать
REPLY_DELAY=20
HISTORY_LIMIT=40

# Кому отвечать (username без @ или числовой id, через запятую). Пусто — всем.
WHITELIST=
# Кому никогда не отвечать
BLACKLIST=
